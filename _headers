# Cloudflare (Workers ou Pages) : en-têtes HTTP (équivalent du netlify.toml).
# Cloudflare enlève le .html des adresses : /salao.html devient /salao, /check.html devient /check.
# Les fichiers que Seb modifie ne doivent jamais être servis depuis un vieux cache.
/data/*
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/salao
  Cache-Control: public, max-age=0, must-revalidate
/check
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
